# =========================
# 6.6 Naive Bayes Improvement
# =========================
# Stable tuning control for Naive Bayes
ctrl_nb_tune <- trainControl(
method = "cv",
number = 5,
classProbs = TRUE,
summaryFunction = mnLogLoss,
sampling = "smote",
allowParallel = FALSE
)
# Small tuning grid for speed and stability
nb_grid <- expand.grid(
laplace = c(0, 1),
usekernel = c(FALSE, TRUE),
adjust = c(1)
)
set.seed(5003)
nb_tuned <- train(
`Degree of crash` ~ .,
data = df_train_nb,
method = "naive_bayes",
trControl = ctrl_nb_tune,
metric = "logLoss",
tuneGrid = nb_grid
)
# Best tuning parameters and CV results
nb_tuned$bestTune
nb_tuned$results
# =========================
# Tuned Naive Bayes Evaluation
# =========================
pred_nb_tuned <- predict(nb_tuned, df_test_nb)
cm_nb_tuned <- confusionMatrix(
pred_nb_tuned,
df_test_nb$`Degree of crash`
)
# Extract metrics
recall_nb_tuned <- cm_nb_tuned$byClass[, "Sensitivity"]
precision_nb_tuned <- cm_nb_tuned$byClass[, "Pos Pred Value"]
f1_nb_tuned <- 2 * precision_nb_tuned * recall_nb_tuned /
(precision_nb_tuned + recall_nb_tuned)
f1_nb_tuned[is.na(f1_nb_tuned)] <- 0
macro_f1_nb_tuned <- mean(f1_nb_tuned, na.rm = TRUE)
fatal_recall_nb_tuned <- recall_nb_tuned["Class: Fatal"]
f1_names_tuned_clean <- gsub("Class: ", "", names(f1_nb_tuned))
weighted_f1_nb_tuned <- sum(
f1_nb_tuned * class_weights[f1_names_tuned_clean],
na.rm = TRUE
)
kappa_nb_tuned <- cm_nb_tuned$overall["Kappa"]
nb_tuned_metrics <- data.frame(
Model = "Tuned Naive Bayes",
Macro_F1 = round(macro_f1_nb_tuned, 3),
Fatal_Recall = round(fatal_recall_nb_tuned, 3),
Weighted_F1 = round(weighted_f1_nb_tuned, 3),
Kappa = round(kappa_nb_tuned, 3)
)
knitr::kable(
nb_tuned_metrics,
caption = "Tuned Naive Bayes Performance Metrics"
)
# =========================
# Before vs After Comparison
# =========================
nb_before_after <- data.frame(
Model = c("Baseline NB", "Tuned NB"),
Macro_F1 = c(round(macro_f1_nb, 3), round(macro_f1_nb_tuned, 3)),
Fatal_Recall = c(round(fatal_recall_nb, 3), round(fatal_recall_nb_tuned, 3)),
Weighted_F1 = c(round(weighted_f1_nb, 3), round(weighted_f1_nb_tuned, 3)),
Kappa = c(round(kappa_nb, 3), round(kappa_nb_tuned, 3))
)
knitr::kable(
nb_before_after,
caption = "Naive Bayes Before and After Hyperparameter Tuning"
)
# =========================
# Compact Visualisation
# =========================
# Tuning plot
p_nb_tune <- ggplot(
nb_tuned$results,
aes(
x = factor(laplace),
y = logLoss,
fill = as.factor(usekernel)
)
) +
geom_col(position = "dodge", width = 0.7) +
labs(
title = "NB Tuning Results",
x = "Laplace",
y = "CV Log Loss",
fill = "Kernel"
) +
theme_minimal(base_size = 10) +
theme(
plot.title = element_text(size = 11, face = "bold"),
legend.position = "bottom"
)
# Tuned confusion matrix heatmap
cm_nb_tuned_df <- as.data.frame(cm_nb_tuned$table)
p_nb_tuned_cm <- ggplot(
cm_nb_tuned_df,
aes(x = Reference, y = Prediction, fill = Freq)
) +
geom_tile(color = "white") +
geom_text(aes(label = Freq), size = 3) +
scale_fill_gradient(low = "white", high = "steelblue") +
labs(
title = "Tuned NB Confusion Matrix",
subtitle = paste0("Fatal Recall = ", round(fatal_recall_nb_tuned, 3)),
x = "Actual",
y = "Predicted",
fill = "Count"
) +
theme_minimal(base_size = 10) +
theme(
plot.title = element_text(size = 11, face = "bold"),
plot.subtitle = element_text(size = 9),
legend.position = "right"
)
# Display two ggplots side by side using built-in grid package
grid::grid.newpage()
grid::pushViewport(
grid::viewport(
layout = grid::grid.layout(1, 2)
)
)
print(
p_nb_tune,
vp = grid::viewport(
layout.pos.row = 1,
layout.pos.col = 1
)
)
print(
p_nb_tuned_cm,
vp = grid::viewport(
layout.pos.row = 1,
layout.pos.col = 2
)
)
knitr::opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE,
fig.align = "center", out.width = "90%")
